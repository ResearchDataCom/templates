## General

# Do not store credentials in Git repositories!
.secrets*
.vars*
*.cert
*.crt
*.pem

## Node.js (https://github.com/github/gitignore)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage;
# cf. https://gruntjs.com/creating-plugins#storing-task-files
.grunt

# Bower dependency directory; cf. https://bower.io/
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons; cf. https://nodejs.org/api/addons.html
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory; cf. https://snowpack.dev/
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache; cf. https://parceljs.org/
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/

# Uncomment the following if your project uses Gatsby and not Next.js;
# cf. https://nextjs.org/blog/next-9-1#public-directory-support.
#public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Visual Studio Code versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Astro generated types
.astro/

# Turbo Repo
.turbo

## Python (https://github.com/github/gitignore)

# Do not store credentials in Git repositories!
.secrets*
.vars*

# Virtual environments can be named anything, but these are common.
.env*
.venv*
env*.bak*/
env*/
ENV*/
venv*.bak*/
venv*/

# Development tools including CMake, Cython, Gradle, IntelliJ, Maven,
# mypy, Pyre, and pytype generate these temporary files.
.dmypy.json
.idea_modules/
.idea/
.mypy_cache/
.pyre/
.pytype/
*.iml
*.ipr
*.iws
atlassian-ide-plugin.xml
cmake-build-*/
com_crashlytics_export_strings.xml
crashlytics-build.properties
crashlytics.properties
cython_debug/
dmypy.json
fabric.properties
out/

# These pre-processed, byte-compiled, or otherwise optimized files can
# sneak into project directories via editable installations.
__pycache__/
*.py[cod]
*$py.class

# Only specify version constraints in pyproject.toml.  Freeze
# dependencies at release time, instead.
.pdm.toml
.python-version
pdm.lock
Pipfile.lock
poetry.lock
requirements*.txt

# Test results or code coverage reports shouldn't be saved alongside
# the code.  If necessary, publish them at release time or archive
# them with CI workflow logs.
.cache
.coverage
.coverage.*
.hypothesis/
.nox/
.pytest_cache/
.tox/
*.cover
*.py,cover
cov_*
cover/
coverage.xml
htmlcov/
nosetests.xml

# Built source (sdist) or binary distributions (wheels) are published
# via the Git repository's _Releases_ page or a package repository.
# Ignore related temporary files, too.
__pypackages__/
.eggs/
.installed.cfg
.Python
*.egg
*.egg-info/
build*/
develop-eggs/
dist*/
downloads/
eggs/
lib/
lib64/
MANIFEST
parts/
sdist*/
share/python-wheels/
var/
wheels/

# The same goes for C extensions.
*.dll
*.dylib
*.so

# Usually, a script generates these files from templates before
# PyInstaller builds the executable.
*.manifest
*.spec

# GNU gettext compiles editable message catalogs into these files.
*.mo
*.pot

# Do not save installer logs.
pip-log.txt
pip-delete-this-directory.txt

# Various frameworks will generate these files, e.g., Celery, Django,
# Flask, IPython, Jupyter, mkdocs, PyBuilder, Rope, SageMath, Scrapy,
# Sphinx, and Spyder.
.ipynb_checkpoints
.pybuilder/
.ropeproject
.scrapy
.spyderproject
.spyproject
.webassets-cache
*.log
*.sage.py
/site
celerybeat-schedule
celerybeat.pid
db.*
docs/_build/
docs/apidocs/
instance/
ipython_config.py
local_settings.py
profile_default/
target/

## macOS (https://github.com/github/gitignore)

# Exclude temporary files, thumbnails, etc. generated by Finder,
# Spotlight, and friends.
._*
.apdisk
.AppleDB
.AppleDesktop
.AppleDouble
.com.apple.timemachine.donotpresent
.DocumentRevisions-V100
.DS_Store
.fseventsd
.LSOverride
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
Network Trash Folder
Temporary Items

# This filename must end with a \r (carriage return).  The range match
# notation protects the carriage return character from being stripped
# by Git's automatic line ending conversion feature or malfunctioning
# text editors; see also https://stackoverflow.com/a/33974028.
Icon[]
